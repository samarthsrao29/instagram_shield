{
  "manifest_version": 3,
  "name": "Focus Shield",
  "version": "1.0",
  "description": "Block Instagram after 2 minutes, unblock by reading about AI for 5 minutes.",
  "options_page": "options.html",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "webNavigation"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Focus Analytics"
  },
  "host_permissions": [
    "*://*.instagram.com/*",
    "https://api.groq.com/*",
    "https://*.supabase.co/*"
  ]
}
